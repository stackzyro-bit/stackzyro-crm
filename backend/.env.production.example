# ==============================================================================
# STACKZYRO CRM – Production Backend Environment Variables
# ==============================================================================
# Set these in your online hosting dashboard (Render / Railway / Cloud Service).
# Never commit your actual production .env with passwords into public git repos!

# 1. DATABASE CONFIGURATION (Managed PostgreSQL)
# Example: postgresql+psycopg://username:password@ep-cool-db.us-east-2.aws.neon.tech/stackzyro?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# 2. JWT SECURITY SECRET KEY
# Generate a strong 64-character random string on your terminal with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_64_character_hex_secret_key

# 3. CORS WHITELIST (FRONTEND HOSTS)
# Comma-separated list of allowed frontend domains without trailing slashes.
# Include both custom domain and your Netlify app domain.
CORS_ORIGINS=https://crm.stackzyro.com,https://your-app.netlify.app

# 4. SAMPLE SEEDING (CRITICAL: MUST BE FALSE IN PRODUCTION)
# Setting this to false prevents demo data and test accounts from overriding your real data.
SEED_SAMPLE_DATA=false

# 5. SESSION TIMEOUT (Minutes)
# 720 minutes = 12 hours. Set to 1440 for 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720
