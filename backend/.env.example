# Copy to backend/.env and adjust.

# PostgreSQL (production / recommended)
# DATABASE_URL=postgresql+psycopg://stackzyro:stackzyro@localhost:5432/stackzyro
# Install the driver first: pip install "psycopg[binary]"

# Local fallback used when DATABASE_URL is not set
DATABASE_URL=sqlite:///./stackzyro.db

# Use a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Comma separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the clearly-labelled sample workspace on first run
SEED_SAMPLE_DATA=true
